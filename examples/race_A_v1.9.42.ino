float FT_GX = 0, FT_GY = 0;   // 現場微調・夾取點：X 往車子右邊＋、Y 往前＋（cm）；手動模式按住 START＋←→／↑↓
float FT_PX = 0, FT_PY = 0;   // 現場微調・放置點：X 往車子右邊＋、Y 往前＋（cm）；手動模式按住 START＋□○／△✕
