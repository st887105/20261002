int irO[6] = {-1, -1, -1, -1, -1, -1};   // 沒有牆（開放空間）時的 IR 讀數；用來判斷「有牆／沒牆」差得夠不夠（黑色隔板反光弱）
bool irSaved = false;   // 是否做過 IR 校正模式（沒做過就略過自動流程的 IR 靠牆校正，避免用錯的目標值把車子轉歪）
double bnoZero = 0;   // BNO 0° 的位置（BNO 校正模式按 A 設定）

