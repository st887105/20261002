}

void runAuto() {   // 一鍵自動流程
  if (abortAuto()) return;
  // 起點設為定點原點（BNO 精準定點：之後每個路徑點都用座標前往）
  setOrigin();
  if (abortAuto()) return;
  // 出發前-1 手臂抬升到 55°
  ATARM_LiftSet(55 + FT_ARM,0);   // 手臂升降
  if (abortAuto()) return;
  // 出發前-2 夾爪張開
  ATARM_ClawCtrl(false,0);   // 夾爪張開
  if (abortAuto()) return;
  // ===== P1 前往 (65, 210) 車頭 180° =====
  mtc.setHeadingSettle(8.0, 0, 30);   // 不停車：到點不等車頭轉正，直接接下一段
  moveGuard = irGuard;   // 長距離快速移動：前方 IR 看到牆太近就停，避免撞牆
  goToV((-1), 62, 0, autoV(2000), autoV(4500), autoV(3000), autoV(0), autoV(800));   // 不停車接下一段，定點座標 (-1, 62)
  moveGuard = nullptr;
  if (abortAuto()) return;
  // ===== P2 前往 (78, 187) 車頭 180° =====
  mtc.setHeadingSettle(1.0, 80, 1000);   // 到點：車頭轉正到 1° 內
  goToV((-14) + (-3) + FT_GX, 82 + FT_GY, 0, autoV(1000), autoV(2000), autoV(1200), autoV(800), autoV(0));   // 接續上一段，定點座標 (-14, 85)
  if (abortAuto()) return;
  grabBackOff();   // ① 前方 9 cm 內有物品就退到 9 cm（沒做 IR 距離校正就跳過）
  if (abortAuto()) return;
  // P2-1 手臂下降到 2°
  ATARM_LiftSet(2,0);   // 手臂升降
  if (abortAuto()) return;
  // P2-2 等待 0.4 秒
  delay(0.4 * 1000);
  if (abortAuto()) return;
  // P2-3 夾爪夾緊
  ATARM_ClawCtrl(true,0);   // 夾爪夾緊
  if (abortAuto()) return;
  // P2-4 等待 0.3 秒
  delay(0.3 * 1000);
  if (abortAuto()) return;
  // P2-5 手臂抬升到 55°
  ATARM_LiftSet(55 + FT_ARM,0);   // 手臂升降
  if (abortAuto()) return;
  // P2-6 等待 0.2 秒
  delay(0.2 * 1000);
  if (abortAuto()) return;
  // ===== P3 前往 (80, 184) 車頭 90° =====（2026/10/30 依實測調整）
  mtc.setHeadingSettle(3.0, 30, 300);   // 長距離：車頭差 3° 內就走下一段（省時）
  goTo((-16), 88, 90, autoV(1500), autoV(3500), autoV(2200));   // 定點座標 (-16, 88)，車頭右轉 90°
  if (abortAuto()) return;
  // ===== P4 前往 (28.4, 165) 車頭 90° =====
  mtc.setHeadingSettle(3.0, 30, 300);   // 長距離：車頭差 3° 內就走下一段（省時）
  goTo(35.6 + FT_PY, 107, 0, autoV(2000), autoV(4500), autoV(3000));   // 定點座標 (35.6, 107)
  if (abortAuto()) return;
  // ===== P5 前往 (30, 106) 車頭 90° =====（2026/10/30 依實測調整）
  mtc.setHeadingSettle(1.0, 80, 1000);   // 到點：車頭轉正到 1° 內
  goTo(34 + FT_PY, 166 + 5 - FT_PX, 0, autoV(1500), autoV(3500), autoV(2200));   // 定點座標 (34, 166)
  if (abortAuto()) return;
  p5Recover(34 + FT_PY, 166 + 5 - FT_PX);   // ③ 前方 3 cm 內沒看到放置盒：後退、往左找牆、回到 P5（沒做 IR 距離校正就跳過）
  if (abortAuto()) return;
  // ===== P6 前往 (27, 107) 車頭 90° =====
  mtc.setHeadingSettle(1.0, 80, 1000);   // 到點：車頭轉正到 1° 內
  goTo(37 + FT_PY, 165 + 5 - FT_PX, 0, autoV(800), autoV(1500), autoV(900));   // 定點座標 (37, 165)
  if (abortAuto()) return;
  ATARM_LiftSet(PLACE_DEG, 0.4);   // ② 到放置點：手臂先慢慢下降到 40° 再張爪，齒輪平穩放上放置台
  delay(400);
  if (abortAuto()) return;
  // P6-1 夾爪張開
  ATARM_ClawCtrl(false,0);   // 夾爪張開
  if (abortAuto()) return;
  // P6-2 等待 0.3 秒
  delay(0.3 * 1000);
  if (abortAuto()) return;
  ATARM_LiftSet(55 + FT_ARM, 0.4);   // 放好後手臂升回 55°（搬運高度），之後移動時夾爪不會碰掉放好的齒輪
  delay(400);
}

void bnoImuMode() {   // BNO055 改成 IMU 模式（只用陀螺儀＋加速度計，不用地磁）：室內馬達、鐵件、手機會讓地磁亂跳，車頭角度突然差很多度就會「迷航」
  Wire.beginTransmission(0x28); Wire.write(0x3D); Wire.write(0x00); Wire.endTransmission();   // 先進設定模式
  delay(25);
  Wire.beginTransmission(0x28); Wire.write(0x3D); Wire.write(0x08); Wire.endTransmission();   // 0x08＝IMU（IMUPLUS）模式
  delay(30);
}

bool bnoSteady() {   // 按 START 時確認 BNO 角度穩定（車子靜止、讀數不跳），最多等 2 秒
  if (!bnoOK) return true;
  unsigned long t0 = millis();
  while (millis() - t0 < 2000) {
    double a = bno.orientationZ;
    delay(150);
    double b = bno.orientationZ;
    double d = fabs(b - a);
    if (d > 180) d = 360 - d;
    if (!isnan(a) && !isnan(b) && d < 0.5) return true;
  }
  return false;
}

void setup() {
  tubit.init();
  tuneLoad();   // 讀取現場微調與 IR 校正值（存在快閃記憶體）
  display.begin(0x3C, true);
  bnoOK = bnoFound();
  if (bnoOK) bno.start();   // 找到 BNO055 才啟動
  if (bnoOK) bnoImuMode();   // 不用地磁：避免車頭角度隨機亂跳（迷航）
  else {   // 找不到 BNO055：序列埠與 OLED 列出 I2C 上找到的位址，判斷是沒接好還是位址不對
    String found = i2cList();
    Serial.println("BNO055 not found (I2C 0x28): check SDA/SCL/VIN/GND");
    Serial.println("I2C devices: " + found + (found.indexOf("0x29") >= 0 ? " -> BNO at 0x29: connect ADR pin to GND" : ""));
    display.clearDisplay();
    display.setFont();
    display.setTextSize(1);
    display.setTextColor(SH110X_WHITE);
    display.setCursor(0, 0);
    display.println("NO BNO055 at 0x28");
    display.println("I2C found:");
    display.println(found);
    display.println(found.indexOf("0x29") >= 0 ? "ADR pin -> GND" : "check VIN GND SDA SCL");
    display.display();
    delay(3000);
  }
  if (bnoOK) {   // 新版 MTC V3：定點移動用 BNO 修正航向
    unsigned long tuMtcBnoWaitStart = millis();
    while (!TuMtcBnoReadyCompat::read(bno, 0) && millis() - tuMtcBnoWaitStart < 5000UL) delay(20);
    mtc.setYawReader(readTuMtcBnoOrientationZ);
    mtc.setYawDirection(1);
    mtc.setHeadingPid(3.0, 0.0, 0.03, 120.0, 60.0);
    mtc.setHeadingSettle(1.0, 100, 1500);
  }
  Ps3.begin(PS3_MAC);   // 手把 MAC：在程式最上方的 PS3_MAC 修改
  tuirAlign();   // 初始化 IR 靠牆校正模式 麥克納姆輪 MTC
  tuirAlign().setPins(33,32,35,34,39,36);   // 前 後 左前 左後 右前 右後
  tuirAlign().setTargets(irT[0],irT[1],irT[2],irT[3],irT[4],irT[5]);   // 目標值：IR 校正模式量到的數值（沒量過就用預設）
  ATARM_INIT(S0,S7,S6);   // 旋轉, 升降, 夾爪
  ATARM_SetClawRange(80,150);   // 張開, 夾緊
  armApply(false);   // 手臂升降範圍 2～55°（搬運角度含現場微調）
  ATARM_SetPanRange(55,125);   // 旋轉範圍
  ATARM_LiftSet(55 + FT_ARM, 1);   // 開機就把手臂抬到搬運高度，按 START 後不用再等手臂抬起
  bool bootA = tubit.readButton(Button_A), bootB = tubit.readButton(Button_B);
  if (bootA && bootB) irDistCal();   // 開機時同時按住 A＋B：IR 距離校正（9 cm／3 cm／貼住／左邊貼牆）
  else if (bootA) irCalMode();   // 開機時按住控制板 A：IR 校正模式
  else if (bootB) bnoCalMode();   // 開機時按住控制板 B：BNO 校正模式
  tuneShow("READY");   // 開機顯示目前微調值
  delay(800);

  Serial.println("PLACE A at (64, 272) head 180 deg");   // 規劃器的出發點，車子一定要擺在這裡
  display.clearDisplay();
  display.setFont();
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);
  display.setCursor(0, 0);
  display.println("PLACE CAR AT");
  display.println("RED  X64 Y272 DOWN");
  display.println("BLUE X236 Y28 UP");
  display.println("SELECT=SIDE START=GO");
  display.println(bnoOK ? "BNO OK" : "BNO NONE!");
  display.println(irSaved ? "IR CAL OK" : "IR NOT CAL! hold A");
  display.println(irDistSaved ? "IRD OK" : "IRD NOT CAL (A+B)");
  display.display();
  delay(2500);
  showMode();
}

void loop() {
  if (!autoMode) tuneKeys();   // 手動模式：按住 START＋L1／L2／R1／R2 現場微調
  if (!autoMode && selectClick()) {   // 按 SELECT 選邊：第 1 下＝紅方，再按一下換藍方／紅方（只按 SELECT 不會啟動）
    sideBlue = sideArmed ? !sideBlue : false;
    sideArmed = true;
    showSide();
  }
  if (!autoMode && autoKey()) {   // 選好邊再按 START 才進自動
    if (!sideArmed) {
      showSide();   // 還沒選邊：提示先按 SELECT
    } else if (!bnoSteady()) {   // BNO 角度不穩定：先不出發（出發時角度錯，整條路線都會偏）
      Serial.println("BNO NOT STEADY: keep car still, press START again");
      display.clearDisplay();
      display.setFont();
      display.setTextSize(1);
      display.setTextColor(SH110X_WHITE);
      display.setCursor(0, 0);
      display.println("BNO NOT STEADY");
      display.println("KEEP CAR STILL");
      display.println("PRESS START AGAIN");
      display.display();
      Ps3.setRumble(100, 150);
    } else {
      autoMode = true;
      autoDone = false;
      Ps3.setRumble(100, 300);
      showMode();
    }
  }
  if (autoMode && manualKey()) {   // 一鍵切回手動
    autoMode = false;
    tubit.stopAllMotors();
    sideReset();
    Ps3.setRumble(100, 300);
    showMode();
  }
  if (autoMode) {
    if (!autoDone) {
      runAuto();   // 紅藍對稱：兩邊用同一條流程（以出發點為原點）
      if (!autoMode) {   // 途中按了手動鍵
        sideReset();
        showMode();
        return;
      }
      if (AUTO_AFTER != 1) {   // 1＝重複執行：不標記完成，下一圈再跑一次
        autoDone = true;
        tubit.stopAllMotors();
        if (AUTO_AFTER == 2) autoMode = false;
        sideReset();   // 做完自動回手動；下次自動要再按 SELECT 選邊
        showMode();
      }
    }
    return;   // 自動模式中不接受遙控，按手動鍵才切回
  }
  remoteControl();   // 手動遙控：移動＋按鍵對應
}
